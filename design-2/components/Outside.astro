---
import { Image } from 'astro:assets';
import { beyond, outside } from '../../src/data/site';
import { findImage } from '../../src/lib/images';

interface Tile {
  kind: string;
  label: string;
  title?: string;
  text: string;
  href?: string;
  image?: string;
  alt?: string;
}

const tiles = beyond.tiles as Tile[];
const pick = (kind: string) => tiles.find((tile) => tile.kind === kind);
const quote = pick('quote');
const note = pick('note');
const event = pick('event');
const project = pick('project');
// Any tile with `image` set in src/data/site.ts shows that photo instead of text.
const photo = (tile?: Tile) => findImage(tile?.image);
---

<section id="outside" class="block" aria-labelledby="outside-label">
  <div class="col">
    <h2 id="outside-label" class="kicker">{outside.label}</h2>
    <p class="lede">{outside.text}</p>

    <div class="grid">
      {
        quote && (
          <figure class="tile tall quote" data-reveal>
            {photo(quote) ? (
              <Image src={photo(quote)!} alt={quote.alt ?? ''} width={480} format="webp" />
            ) : (
              <>
                <figcaption>{quote.label}</figcaption>
                <blockquote>“{quote.text}”</blockquote>
              </>
            )}
          </figure>
        )
      }
      {
        note && (
          <div class="tile tall note" data-reveal style="--d:1">
            {photo(note) ? (
              <Image src={photo(note)!} alt={note.alt ?? ''} width={480} format="webp" />
            ) : (
              <>
                <p class="tile-label">{note.label}</p>
                <p class="big">{note.text}</p>
              </>
            )}
          </div>
        )
      }
      <div class="stack">
        {
          event && (
            <div class="tile event" data-reveal style="--d:2">
              <p class="tile-label">{event.label}</p>
              <p class="tile-title">{event.title}</p>
              <p class="tile-text">{event.text}</p>
            </div>
          )
        }
        {
          project?.href && (
            <a class="tile more" href={project.href} data-reveal style="--d:3">
              <span>
                Read the {project.title} story <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .lede {
    max-width: 58ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  .stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    min-height: 140px;
    padding: 18px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.3s var(--ease),
      opacity 0.7s var(--ease-out);
  }

  .tile:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--accent-rgb), 0.6);
  }

  .tall {
    min-height: 296px;
  }

  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-label,
  figcaption {
    font-size: 10.8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .quote {
    background:
      radial-gradient(ellipse 90% 70% at 0% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
  }

  blockquote {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-wrap: balance;
  }

  .note {
    border-color: transparent;
    background: var(--accent-fill);
    color: var(--accent-ink);
  }

  .note .tile-label {
    color: inherit;
    opacity: 0.75;
  }

  .big {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .tile-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
  }

  .tile-text {
    font-size: 12.4px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* The dark "more" tile stays dark in both themes, as in the reference. */
  .more {
    align-items: center;
    justify-content: center;
    border-color: transparent;
    background: #050506;
    color: #f4f4f8;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stack {
      grid-column: 1 / -1;
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tall {
      min-height: 230px;
    }
  }
</style>
