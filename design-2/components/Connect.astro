---
import { connect, site } from '../../src/data/site';
---

<section id="connect" class="connect" aria-labelledby="connect-title">
  <div class="col">
    <h2 id="connect-title">{connect.heading}</h2>
    <p class="lede">{connect.text}</p>

    <!-- Works without a server: it opens the visitor's email app with the message ready to send. -->
    <form
      class="form"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
      data-mail-form={site.email}
    >
      <label class="field">
        <span class="field-label">Name</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label class="field">
        <span class="field-label">Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span class="field-label">Phone <span class="optional">Optional</span></span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label class="field">
        <span class="field-label">Company <span class="optional">Optional</span></span>
        <input type="text" name="company" autocomplete="organization" />
      </label>
      <label class="field wide">
        <span class="field-label">Message</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <div class="send wide">
        <button type="submit" class="btn btn-soft">
          Send it <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="hint">
          {connect.note} Or write to <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  /* A full-width band in a slightly different tone closes the page. */
  .connect {
    margin-top: var(--block);
    padding-block: clamp(44px, 7vw, 64px);
    background: var(--band);
    transition: background-color 0.35s var(--ease);
  }

  h2 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .lede {
    margin-top: 8px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
    margin-top: 24px;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .field {
    display: grid;
    gap: 7px;
  }

  .field-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
  }

  .optional {
    font-size: 10.5px;
    font-weight: 400;
    color: var(--ink-faint);
  }

  input,
  textarea {
    width: 100%;
    padding: 11px 13px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: 14px;
    line-height: 1.5;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      background-color 0.35s var(--ease);
  }

  textarea {
    min-height: 124px;
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: var(--line-strong);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .hint {
    font-size: 12px;
    color: var(--ink-faint);
  }

  .hint a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s var(--ease);
  }

  .hint a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
