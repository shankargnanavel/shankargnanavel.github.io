---
import Icon from '../../src/components/Icon.astro';
import { site } from '../../src/data/site';

interface Props {
  back?: boolean;
}
const { back = false } = Astro.props;
---

<header class="header">
  <div class:list={['bar', { 'bar-wide': back }]}>
    {
      back ? (
        <a class="back" href="/">
          <Icon name="home" size={16} /> Back to home
        </a>
      ) : (
        <a class="brand" href="/#top" aria-label={`${site.name}, home`}>
          <svg class="mark" width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="16" fill="currentColor" opacity="0.12" />
            <path
              d="M42.7 23A14 14 0 1 0 46 32H34"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="wordmark">{site.shortName}</span>
        </a>
      )
    }

    <nav class="nav" aria-label="Primary">
      {
        !back && (
          <>
            <a href="/#work">Work</a>
            <a class="hide-s" href="/#experience">Experience</a>
            <a href={site.resumePdf || '/#experience'} target={site.resumePdf ? '_blank' : undefined} rel="noopener">
              Resume
              {site.resumePdf && <span class="sr-only"> (PDF, opens in a new tab)</span>}
            </a>
          </>
        )
      }
      <div class="toggle" role="group" aria-label="Theme">
        <button type="button" data-mode-set="pixel" aria-pressed="true">Pixel</button>
        <button type="button" data-mode-set="paper" aria-pressed="false">Paper</button>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: background-color 0.35s var(--ease);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(100% - var(--gutter) * 2, var(--col));
    height: 56px;
    margin-inline: auto;
  }

  .bar-wide {
    width: min(100% - var(--gutter) * 2, 1120px);
  }

  .brand,
  .back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    transition: color 0.2s var(--ease);
  }

  .brand:hover,
  .back:hover {
    color: var(--accent);
  }

  .mark {
    transition: transform 0.4s var(--ease-out);
  }

  .brand:hover .mark {
    transform: rotate(-12deg);
  }

  .wordmark {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .back {
    font-size: 13.5px;
    font-weight: 600;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 22px);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.2s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  /* Paper sets the links in sentence case, as on a printed page. */
  :global(html[data-mode='paper']) .nav a {
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }

  .toggle {
    display: flex;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
  }

  .toggle button {
    min-height: 24px;
    padding: 0 10px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .toggle button:hover {
    color: var(--ink);
  }

  .toggle button[aria-pressed='true'] {
    background: var(--line-strong);
    color: var(--ink);
  }

  :global(html[data-mode='paper']) .toggle button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* A larger tap area than the visible pill. */
  .toggle button {
    position: relative;
  }

  .toggle button::after {
    content: '';
    position: absolute;
    inset: -10px 0;
  }

  @media (max-width: 520px) {
    .wordmark {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .hide-s {
      display: none !important;
    }
  }

  @media print {
    .header {
      display: none;
    }
  }
</style>
