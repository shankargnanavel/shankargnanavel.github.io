---
import { Image } from 'astro:assets';
import { projects } from '../../src/data/projects';
import { findImage } from '../../src/lib/images';

const cards = projects.map((project) => ({
  project,
  image: findImage(project.cover),
  soon: project.status === 'in-progress',
}));
---

<section id="work" class="block" aria-labelledby="work-label">
  <div class="col">
    <h2 id="work-label" class="kicker">Selected work</h2>

    <ul class="list">
      {
        cards.map(({ project, image, soon }) => {
          const Tag = soon ? 'div' : 'a';
          return (
            <li data-reveal>
              <Tag
                class:list={['pcard', { 'is-soon': soon }]}
                href={soon ? undefined : `/work/${project.slug}/`}
                style={`--tint:${project.tint ?? '#9398ff'}`}
              >
                <div class="media" style={soon ? undefined : `view-transition-name: cover-${project.slug}`}>
                  {image ? (
                    <Image
                      src={image}
                      alt=""
                      width={1360}
                      widths={[480, 720, 1360]}
                      sizes="(min-width: 760px) 680px, 92vw"
                      format="webp"
                      quality={80}
                    />
                  ) : (
                    <span class="plate" aria-hidden="true">
                      <span class="plate-label">{project.label}</span>
                      <span class="plate-name">{project.name}</span>
                    </span>
                  )}
                  {soon && <span class="chip">Work in progress</span>}
                </div>
                <div class="body">
                  <h3>{project.name}</h3>
                  <p class="desc">{project.card}</p>
                  {soon ? (
                    <span class="state">In progress · happy to talk it through</span>
                  ) : (
                    <span class="go">
                      view case study <span class="arrow" aria-hidden="true">→</span>
                    </span>
                  )}
                </div>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 26px;
  }

  .pcard {
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.3s var(--ease),
      box-shadow 0.45s var(--ease-out);
  }

  a.pcard:hover,
  a.pcard:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(var(--accent-rgb), 0.65);
    box-shadow: 0 26px 50px -30px rgba(var(--accent-rgb), 0.55);
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0b0b0f;
  }

  /* Cover artwork is drawn at 4:3, so show all of it. */
  .media:has(:global(img)) {
    aspect-ratio: 4 / 3;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  a.pcard:hover .media :global(img),
  a.pcard:hover .plate {
    transform: scale(1.035);
  }

  /* Type-only cover for projects without an image: a tinted glow on black. */
  .plate {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 7%;
    color: #f4f4f8;
    background:
      radial-gradient(ellipse 70% 90% at 78% 8%, color-mix(in srgb, var(--tint) 46%, transparent), transparent 68%),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.13) 1px, transparent 1.5px) 0 0 / 20px 20px,
      #0b0b0f;
    transition: transform 0.9s var(--ease-out);
  }

  .plate-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 244, 248, 0.72);
  }

  .plate-name {
    font-size: clamp(26px, 6vw, 44px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .chip {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    padding: 9px 16px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(18, 18, 22, 0.78);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #f4f4fa;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .is-soon .plate-name {
    filter: blur(1.5px);
    opacity: 0.55;
  }

  .body {
    display: grid;
    gap: 8px;
    padding: 20px 22px 22px;
  }

  h3 {
    font-size: 21.5px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .desc {
    font-size: 13.8px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .go,
  .state {
    margin-top: 6px;
    font-size: 11.5px;
  }

  .go {
    font-weight: 600;
    color: var(--accent);
  }

  .state {
    color: var(--ink-faint);
  }
</style>
