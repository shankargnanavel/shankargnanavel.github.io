---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../src/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Case-study pages show "Back to home" in the header instead of the section links. */
  back?: boolean;
}

const { title = site.title, description = site.description, back = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
const ogImage = site.url ? new URL('/og-2.png', site.url).href : '/og-2.png';
---

<!doctype html>
<html lang="en-GB" class="no-js" data-mode="pixel">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#121216" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon-2.svg" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />

    <!-- Apply the saved theme before the first paint, and turn motion on only once scripts run. -->
    <script is:inline>
      (function (d) {
        var mode = 'pixel';
        try {
          if (localStorage.getItem('mode') === 'paper') mode = 'paper';
        } catch (e) {}
        d.dataset.mode = mode;
        d.classList.replace('no-js', 'js');
        setTimeout(function () {
          if (!window.__siteReady) d.classList.remove('js');
        }, 3500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header back={back} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
