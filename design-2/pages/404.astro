---
import Base from '../layouts/Base.astro';
import { site } from '../../src/data/site';
---

<Base title={`Page not found | ${site.name}`} description="This page does not exist.">
  <section class="col lost">
    <p class="kicker">Error 404</p>
    <h1>This page took a wrong turn</h1>
    <p class="lede">The link is broken or the page has moved. The work is still where it was.</p>
    <p class="actions">
      <a class="btn btn-fill" href="/#work">See my work</a>
      <a class="btn" href="/">Back to home <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</Base>

<style>
  .lost {
    min-height: 62svh;
    display: grid;
    align-content: center;
    padding-block: 80px;
  }

  h1 {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: 10px;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
</style>
