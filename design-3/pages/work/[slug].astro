---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
// The case-study building blocks are shared with the other designs.
import Columns from '../../../src/components/Columns.astro';
import Figure from '../../../src/components/Figure.astro';
import Icon from '../../../src/components/Icon.astro';
import NeedsInput from '../../../src/components/NeedsInput.astro';
import Stats from '../../../src/components/Stats.astro';
import { caseStudies, type Project } from '../../../src/data/projects';
import { site } from '../../../src/data/site';
import { findImage } from '../../../src/lib/images';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return caseStudies.flatMap((project, index) => {
    const entry = entries.find((item) => item.id === project.slug);
    if (!entry) return [];
    return [
      {
        params: { slug: project.slug },
        props: { project, entry, next: caseStudies[(index + 1) % caseStudies.length] },
      },
    ];
  });
}

interface Props {
  project: Project;
  entry: Awaited<ReturnType<typeof getCollection<'work'>>>[number];
  next: Project;
}

const { project, entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const cover = findImage(project.cover);
---

<Base title={`${project.headline} | ${site.name}`} description={project.summary} back>
  <article class="case">
    <header class="wrap top">
      <p class="eyebrow">{project.label}</p>
      <h1>{project.headline}</h1>
      <p class="summary">{project.summary}</p>

      <dl class="meta">
        {
          project.meta.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="wrap">
      <div class="cover" style={`view-transition-name: cover-${project.slug}`}>
        {
          cover ? (
            <Image
              src={cover}
              alt={project.coverAlt}
              width={Math.min(cover.width, 1600)}
              widths={[640, 960, 1280, 1600].filter((w) => w <= cover.width)}
              sizes="(min-width: 1360px) 1216px, 94vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="plate" aria-hidden="true">
              <span class="plate-big">{project.stat?.value}</span>
              <span class="plate-label">{project.stat?.label}</span>
            </div>
          )
        }
      </div>
      {
        !cover && (
          <NeedsInput note={`No cover image yet. Add src/assets/work/${project.slug}/cover.png and set "cover" in src/data/projects.ts.`} />
        )
      }
    </div>

    <section class="wrap tldr" aria-labelledby="tldr-title">
      <h2 id="tldr-title" class="eyebrow">In 30 seconds</h2>
      <div class="tldr-grid">
        <div>
          <h3>Problem</h3>
          <p>{project.tldr.problem}</p>
        </div>
        <div>
          <h3>My role</h3>
          <p>{project.tldr.role}</p>
        </div>
        <div class="outcome">
          <h3>Outcome</h3>
          <p>{project.tldr.outcome}</p>
        </div>
      </div>
      {
        project.links && (
          <p class="links">
            {project.links.map((link) => (
              <a class="pill" href={link.href} target="_blank" rel="noopener">
                {link.label} <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ))}
          </p>
        )
      }
    </section>

    <div class="wrap body">
      <div class="prose">
        <Content components={{ Figure, Stats, Columns, NeedsInput }} />
      </div>

      {
        sections.length > 1 && (
          <nav class="toc" data-toc aria-label="On this page">
            <p class="toc-title">On this page</p>
            <ol>
              {sections.map((section, i) => (
                <li>
                  <a href={`#${section.slug}`}>
                    <span class="toc-num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {section.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    <section class="wrap" aria-label="Next case file">
      <a class="next" href={`/work/${next.slug}/`}>
        <span class="next-eyebrow">Next case file</span>
        <span class="next-name">{next.name}</span>
        <span class="next-big">{next.stat?.value}</span>
        <span class="next-desc">{next.stat?.label}</span>
        <span class="pill">
          Read the case study <span class="arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </section>
  </article>

  <Contact />

  <dialog id="lightbox" aria-label="Enlarged image">
    <button type="button" class="lb-close" data-close aria-label="Close enlarged image">
      <Icon name="x" size={20} />
    </button>
    <figure>
      <img alt="" />
      <figcaption data-caption></figcaption>
    </figure>
  </dialog>
</Base>

<style>
  .top {
    padding-top: clamp(116px, 14vw, 168px);
  }

  h1 {
    max-width: 17ch;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .summary {
    max-width: 54ch;
    margin-top: 24px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px clamp(28px, 5vw, 64px);
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  dd {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 600;
  }

  .cover {
    margin-top: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--surface);
  }

  .cover :global(img) {
    width: 100%;
  }

  /* Type-only cover: the project's headline number on black. */
  .plate {
    display: grid;
    align-content: end;
    gap: 10px;
    min-height: clamp(260px, 34vw, 420px);
    padding: clamp(24px, 4vw, 48px);
    background: #1f1f1f;
    color: #fff;
  }

  .plate-big {
    font-size: clamp(72px, 14vw, 180px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .plate-label {
    max-width: 40ch;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
  }

  .tldr {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .tldr-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .tldr-grid > div {
    padding: 24px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .tldr-grid h3 {
    font-size: 15px;
    font-weight: 600;
  }

  .tldr-grid p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .tldr-grid .outcome {
    border-color: transparent;
    background: var(--blue-soft);
  }

  .outcome h3,
  .outcome p {
    color: var(--blue-ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .links .pill {
    background: var(--surface);
  }

  /* Body: content plus a sticky index on wide screens. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    margin-top: clamp(56px, 8vw, 110px);
  }

  .toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .body {
      grid-template-columns: minmax(0, 860px) 220px;
      justify-content: space-between;
    }

    .toc {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
      max-height: calc(100vh - 130px);
      overflow: auto;
    }
  }

  .toc-title {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .toc a {
    display: flex;
    gap: 12px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--ink-faint);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .toc-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.7;
  }

  .toc a:hover {
    color: var(--ink);
  }

  .toc a:global(.is-current) {
    background: var(--blue-soft);
    color: var(--blue-ink);
    font-weight: 600;
  }

  /* Next case file: a dark card with its headline number. */
  .next {
    display: grid;
    justify-items: start;
    gap: 8px;
    margin-top: clamp(64px, 9vw, 120px);
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--radius-lg);
    background: #1f1f1f;
    color: #fff;
    transition:
      translate 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease);
  }

  .next:hover {
    translate: 0 -4px;
    box-shadow: 0 30px 60px -36px rgba(31, 31, 31, 0.7);
  }

  .next-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .next-name {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .next-big {
    margin-top: 18px;
    font-size: clamp(60px, 9vw, 110px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .next-desc {
    max-width: 44ch;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
  }

  .next .pill {
    --pill-fg: #fff;
    --pill-bd: rgba(255, 255, 255, 0.5);
    margin-top: 18px;
  }

  @media (max-width: 820px) {
    .tldr-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Lightbox */
  #lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgba(15, 15, 15, 0.94);
    color: #fff;
    overflow: auto;
    cursor: zoom-out;
  }

  #lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.3s var(--ease-out);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  #lightbox figure {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  #lightbox img {
    max-width: min(100%, 1800px);
    max-height: calc(100dvh - 140px);
    border-radius: 10px;
    background: #fff;
  }

  #lightbox figcaption {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
  }

  .lb-close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    color: #1f1f1f;
    transition:
      background-color 0.2s var(--ease),
      transform 0.3s var(--spring);
  }

  .lb-close:hover {
    background: var(--yellow);
    transform: rotate(90deg);
  }
</style>

<style is:global>
  /* Typography for case-study bodies (the shared .mdx files) in Design 3. */
  .prose {
    counter-reset: section;
    min-width: 0;
  }

  .prose > :where(p, ul, ol, blockquote, h2, h3, h4) {
    max-width: 700px;
  }

  /* Each section opens with a large italic numeral. */
  .prose h2 {
    counter-increment: section;
    margin: clamp(64px, 9vw, 104px) 0 18px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    scroll-margin-top: 96px;
    text-wrap: balance;
  }

  .prose h2::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(56px, 7vw, 84px);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .prose > h2:first-child {
    margin-top: 0;
  }

  .prose h3 {
    margin: 34px 0 10px;
    font-size: 19.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .prose p {
    margin-block: 14px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :where(ul, ol):not([class]) {
    display: grid;
    gap: 9px;
    margin-block: 14px;
  }

  .prose :where(ul, ol):not([class]) > li {
    position: relative;
    padding-left: 26px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .prose ul:not([class]) > li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--blue);
    background: #fff;
  }

  .prose ol:not([class]) {
    counter-reset: item;
  }

  .prose ol:not([class]) > li {
    counter-increment: item;
    padding-left: 34px;
  }

  .prose ol:not([class]) > li::before {
    content: counter(item, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.22em;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--blue);
  }

  .prose blockquote {
    margin-block: 28px;
  }

  .prose blockquote p {
    display: inline;
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 27px);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--ink);
    background: linear-gradient(var(--yellow), var(--yellow)) 0 88% / 100% 34% no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .prose code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-3);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .prose a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
