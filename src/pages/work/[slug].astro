---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Columns from '../../components/Columns.astro';
import ContactPills from '../../components/ContactPills.astro';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import NeedsInput from '../../components/NeedsInput.astro';
import Stats from '../../components/Stats.astro';
import TypeCover from '../../components/TypeCover.astro';
import { caseStudies as projects, type Project } from '../../data/projects';
import { site } from '../../data/site';
import { findImage } from '../../lib/images';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return projects.flatMap((project, index) => {
    const entry = entries.find((item) => item.id === project.slug);
    if (!entry) return [];
    return [
      {
        params: { slug: project.slug },
        props: { project, entry, next: projects[(index + 1) % projects.length] },
      },
    ];
  });
}

interface Props {
  project: Project;
  entry: Awaited<ReturnType<typeof getCollection<'work'>>>[number];
  next: Project;
}

const { project, entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const cover = findImage(project.cover);
const nextCover = findImage(next.cover);
---

<Base title={`${project.headline} | ${site.name}`} description={project.summary} active="work">
  <article class="case">
    <header class="wrap head">
      <a class="back" href="/#work"><Icon name="arrow-left" size={16} /> All work</a>
      <p class="eyebrow">{project.label}</p>
      <h1>{project.headline}</h1>
      <p class="summary">{project.summary}</p>
      <dl class="meta">
        {
          project.meta.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="wrap">
      <div class="cover" style={`view-transition-name: cover-${project.slug}`}>
        {
          cover ? (
            <Image
              src={cover}
              alt={project.coverAlt}
              width={Math.min(cover.width, 1600)}
              widths={[640, 960, 1280, 1600].filter((w) => w <= cover.width)}
              sizes="(min-width: 1220px) 1120px, 94vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <>
              <TypeCover name={project.name} label={project.label} />
              <NeedsInput note={`No cover image yet. Add src/assets/work/${project.slug}/cover.png and set "cover" in src/data/projects.ts.`} />
            </>
          )
        }
      </div>
    </div>

    <section class="wrap tldr" aria-labelledby="tldr-title">
      <h2 id="tldr-title" class="eyebrow">In 30 seconds</h2>
      <div class="tldr-grid">
        <div>
          <h3>Problem</h3>
          <p>{project.tldr.problem}</p>
        </div>
        <div>
          <h3>My role</h3>
          <p>{project.tldr.role}</p>
        </div>
        <div class="outcome">
          <h3>Outcome</h3>
          <p>{project.tldr.outcome}</p>
        </div>
      </div>
      {
        project.links && (
          <p class="links">
            {project.links.map((link) => (
              <a class="pill pill--sm" href={link.href} target="_blank" rel="noopener">
                {link.label} <Icon name="arrow-up-right" size={14} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ))}
          </p>
        )
      }
    </section>

    <div class="wrap body">
      <div class="prose">
        <Content components={{ Figure, Stats, Columns, NeedsInput }} />
      </div>

      {
        sections.length > 1 && (
          <nav class="toc" data-toc aria-label="On this page">
            <p class="eyebrow">On this page</p>
            <ol>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`}>{section.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    <section class="wrap" aria-label="Next project">
      <a class="next" href={`/work/${next.slug}/`}>
        <span class="next-copy">
          <span class="eyebrow">Next project</span>
          <span class="next-name">{next.name}</span>
          <span class="next-desc">{next.card}</span>
          <span class="more" aria-hidden="true">View case study <Icon name="arrow-up-right" size={14} /></span>
        </span>
        <span class="next-thumb" aria-hidden="true">
          {
            nextCover ? (
              <Image src={nextCover} alt="" width={720} widths={[400, 720]} sizes="360px" format="webp" quality={76} />
            ) : (
              <TypeCover name={next.name} label={next.label} />
            )
          }
        </span>
      </a>
    </section>

    <section class="wrap cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="h-mono">Let's talk</h2>
      <p class="lede">Want the longer version, or the thinking behind a decision? I'm happy to walk you through it.</p>
      <div class="cta-pills"><ContactPills /></div>
    </section>
  </article>

  <dialog id="lightbox" aria-label="Enlarged image">
    <button type="button" class="lb-close" data-close aria-label="Close enlarged image">
      <Icon name="x" size={20} />
    </button>
    <figure>
      <img alt="" />
      <figcaption data-caption></figcaption>
    </figure>
  </dialog>
</Base>

<style>
  .head {
    padding-top: clamp(150px, 20vw, 190px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .back :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  .back:hover :global(svg) {
    transform: translateX(-4px);
  }

  h1 {
    max-width: 18ch;
    margin-top: 14px;
    font-size: clamp(36px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .summary {
    max-width: 56ch;
    margin-top: 22px;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px clamp(28px, 5vw, 64px);
    margin: clamp(32px, 5vw, 48px) 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  dd {
    margin: 6px 0 0;
    font-size: 15px;
    font-weight: 500;
  }

  .cover {
    margin-top: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--surface);
  }

  .cover :global(img) {
    width: 100%;
  }

  .cover :global(.type-cover) {
    aspect-ratio: 16 / 6.5;
    min-height: 240px;
  }

  /* In 30 seconds */
  .tldr {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .tldr-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .tldr-grid > div {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .tldr-grid h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .tldr-grid p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .tldr-grid .outcome {
    background: var(--accent-soft);
    border-color: rgba(var(--accent-rgb), 0.3);
  }

  .outcome h3 {
    color: var(--accent);
  }

  .outcome p {
    color: var(--text);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  /* Body: content column plus a sticky index on wide screens. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 60px;
    margin-top: clamp(56px, 9vw, 110px);
  }

  .toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .body {
      grid-template-columns: minmax(0, 860px) 200px;
      justify-content: space-between;
    }

    .toc {
      display: block;
      position: sticky;
      top: 104px;
      align-self: start;
      max-height: calc(100vh - 140px);
      overflow: auto;
    }
  }

  .toc ol {
    margin-top: 14px;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 7px 0 7px 16px;
    border-left: 1px solid transparent;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--dim);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a:global(.is-current) {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* Next project */
  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    margin-top: clamp(72px, 10vw, 130px);
    padding: clamp(22px, 3.4vw, 36px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s var(--ease),
      box-shadow 0.45s var(--ease-out);
  }

  .next:hover {
    transform: translateY(-6px);
    background: var(--surface-2);
    box-shadow:
      0 0 0 1px rgba(var(--accent-rgb), 0.4),
      0 30px 60px -30px rgba(var(--accent-rgb), 0.35);
  }

  .next-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .next-name {
    font-size: clamp(26px, 3.6vw, 38px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .next-desc {
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .next-thumb {
    display: block;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .next-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .next:hover .next-thumb :global(img) {
    transform: scale(1.045);
  }

  .cta {
    margin-top: var(--section);
    text-align: center;
  }

  .cta .lede {
    max-width: 48ch;
    margin-inline: auto;
  }

  .cta-pills {
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .tldr-grid {
      grid-template-columns: 1fr;
    }

    .next {
      grid-template-columns: 1fr;
    }

    .next-thumb {
      order: -1;
    }
  }

  /* Lightbox */
  #lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgba(0, 0, 0, 0.9);
    color: var(--text);
    overflow: auto;
    cursor: zoom-out;
  }

  #lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.3s var(--ease-out);
  }

  #lightbox::backdrop {
    background: rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  #lightbox figure {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  #lightbox img {
    max-width: min(100%, 1800px);
    max-height: calc(100dvh - 140px);
    border-radius: 10px;
    background: var(--surface);
  }

  #lightbox figcaption {
    font-size: 13.5px;
    color: var(--muted);
    text-align: center;
  }

  .lb-close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(20, 20, 20, 0.85);
    color: var(--text);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .lb-close:hover {
    background: var(--accent);
    color: var(--accent-ink);
    transform: rotate(90deg);
  }
</style>

<style is:global>
  /* Typography for case-study bodies (the .mdx files). */
  .prose {
    counter-reset: section;
    min-width: 0;
  }

  .prose > :where(p, ul, ol, blockquote, h2, h3, h4) {
    max-width: 680px;
  }

  .prose h2 {
    counter-increment: section;
    margin: clamp(64px, 9vw, 104px) 0 20px;
    font-size: clamp(27px, 3.6vw, 38px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    scroll-margin-top: 110px;
    text-wrap: balance;
  }

  .prose h2::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .prose > h2:first-child {
    margin-top: 0;
  }

  .prose h3 {
    margin: 36px 0 12px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .prose p {
    margin-block: 16px;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .prose strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Only plain Markdown lists: component lists (stats and so on) carry a class. */
  .prose :where(ul, ol):not([class]) {
    margin-block: 16px;
    display: grid;
    gap: 10px;
  }

  .prose :where(ul, ol):not([class]) > li {
    position: relative;
    padding-left: 26px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .prose ul:not([class]) > li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    rotate: 45deg;
  }

  .prose ol:not([class]) {
    counter-reset: item;
  }

  .prose ol:not([class]) > li {
    counter-increment: item;
    padding-left: 34px;
  }

  .prose ol:not([class]) > li::before {
    content: counter(item, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .prose blockquote {
    margin-block: 28px;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--accent);
  }

  .prose blockquote p {
    margin: 0;
    color: var(--text);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .prose code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.9em;
    letter-spacing: 0;
  }

  .prose a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-rgb), 0.7);
    text-underline-offset: 3px;
    transition: color 0.2s var(--ease);
  }

  .prose a:hover {
    color: var(--accent);
  }
</style>
