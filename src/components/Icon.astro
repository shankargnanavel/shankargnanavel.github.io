---
/**
 * One place for every icon on the site (Lucide, open source).
 * Usage: <Icon name="mail" /> or <Icon name="arrow-up-right" size={16} />
 */
import Home from '@lucide/astro/icons/house';
import Folder from '@lucide/astro/icons/folder';
import Briefcase from '@lucide/astro/icons/briefcase';
import Sparkles from '@lucide/astro/icons/sparkles';
import Award from '@lucide/astro/icons/award';
import Mail from '@lucide/astro/icons/mail';
import FileText from '@lucide/astro/icons/file-text';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Plus from '@lucide/astro/icons/plus';
import Download from '@lucide/astro/icons/download';
import Printer from '@lucide/astro/icons/printer';
import X from '@lucide/astro/icons/x';
import MapPin from '@lucide/astro/icons/map-pin';
import BadgeCheck from '@lucide/astro/icons/badge-check';

const icons = {
  home: Home,
  folder: Folder,
  briefcase: Briefcase,
  sparkles: Sparkles,
  award: Award,
  mail: Mail,
  file: FileText,
  'arrow-up-right': ArrowUpRight,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  plus: Plus,
  download: Download,
  printer: Printer,
  x: X,
  pin: MapPin,
  check: BadgeCheck,
} as const;

interface Props {
  name: keyof typeof icons | 'linkedin';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const Component = name === 'linkedin' ? null : icons[name];
---

{
  Component ? (
    <Component size={size} stroke-width={1.75} class={className} aria-hidden="true" />
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="M8 11v5.5M8 7.6v.1M12 16.5V11m0 2.4c0-1.5 1-2.4 2.3-2.4S16.5 12 16.5 13.5v3" />
    </svg>
  )
}
