---
/**
 * A case-study image. Click (or press Enter) to see it larger.
 *   <Figure src="work/welns/flow.png" alt="What the image shows" caption="Optional caption" />
 * Images fill the content column. Use size="narrow" for tall sketches.
 */
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import NeedsInput from './NeedsInput.astro';
import { findImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  size?: 'full' | 'narrow';
}

const { src, alt, caption, size = 'full' } = Astro.props;
const image = findImage(src);
const full = image
  ? await getImage({ src: image, width: Math.min(image.width, 2048), format: 'webp', quality: 86 })
  : null;
const widths = image ? [640, 960, 1280, 1600].filter((w) => w <= image.width) : [];
---

{
  image && full ? (
    <figure class:list={['figure', { narrow: size === 'narrow' }]}>
      <button type="button" class="zoom" data-zoom={full.src} data-alt={alt} data-caption={caption ?? ''}>
        <Image
          src={image}
          alt={alt}
          width={Math.min(image.width, 1600)}
          widths={widths.length ? widths : undefined}
          sizes={size === 'narrow' ? '(min-width: 600px) 520px, 94vw' : '(min-width: 1140px) 860px, 94vw'}
          format="webp"
          quality={82}
        />
        <span class="hint" aria-hidden="true">
          <Icon name="plus" size={14} /> Enlarge
        </span>
        <span class="sr-only">Enlarge image</span>
      </button>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ) : (
    <NeedsInput note={`Image not found: src/assets/${src}`} />
  )
}

<style>
  .figure {
    margin-block: 32px;
  }

  .zoom {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    cursor: zoom-in;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.4s var(--ease-out);
  }

  .zoom :global(img) {
    width: 100%;
    transition: transform 0.8s var(--ease-out);
  }

  .zoom:hover,
  .zoom:focus-visible {
    border-color: rgba(var(--accent-rgb), 0.5);
    box-shadow: 0 30px 60px -34px rgba(var(--accent-rgb), 0.5);
  }

  .zoom:hover :global(img) {
    transform: scale(1.015);
  }

  .hint {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .zoom:hover .hint,
  .zoom:focus-visible .hint {
    opacity: 1;
    transform: none;
  }

  figcaption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--dim);
    text-align: center;
  }

  .narrow {
    max-width: 520px;
    margin-inline: auto;
  }
</style>
