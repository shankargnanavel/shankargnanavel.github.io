---
/** A typographic cover used when a project has no cover image yet. */
interface Props {
  name: string;
  label?: string;
}
const { name, label } = Astro.props;
---

<div class="type-cover" aria-hidden="true">
  {label && <span class="label">{label}</span>}
  <span class="name">{name}</span>
</div>

<style>
  .type-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 8% 8% 7%;
    background:
      radial-gradient(ellipse 90% 80% at 0% 0%, rgba(var(--accent-rgb), 0.34), transparent 62%),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.16) 1px, transparent 1.5px) 0 0 / 18px 18px,
      #0b1410;
    container-type: inline-size;
  }

  .label {
    font-family: var(--font-mono);
    font-size: clamp(10px, 3.4cqw, 15px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(22px, 12cqw, 84px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--accent);
    text-wrap: balance;
  }
</style>
