---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { nav, site } from '../data/site';

interface Props {
  /** Which icon to highlight on pages other than the home page. */
  active?: string;
}
const { active = '' } = Astro.props;
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="/">
      <span class="brand-mark"><Mark /></span>
      <span class="brand-name">{site.name}</span>
    </a>
    <span class="rule" aria-hidden="true"></span>
    <ul class="links">
      {
        nav.map((item) => (
          <li>
            <a href={`/#${item.id}`} data-nav={item.id} aria-current={active === item.id ? 'page' : undefined}>
              <Icon name={item.icon} />
              <span class="tip">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/resume/" data-nav="resume" aria-current={active === 'resume' ? 'page' : undefined}>
          <Icon name="file" />
          <span class="tip">Resume</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    pointer-events: none;
  }

  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 52px;
    padding: 0 6px 0 8px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(16, 17, 18, 0.58);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    backdrop-filter: blur(28px) saturate(160%);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 8px 6px 4px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-mark {
    display: grid;
    transition: transform 0.4s var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: rotate(-12deg) scale(1.06);
  }

  .rule {
    width: 1px;
    height: 16px;
    margin-inline: 6px 8px;
    background: rgba(255, 255, 255, 0.85);
  }

  .links {
    display: flex;
    gap: 2px;
  }

  .links a {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .links a :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }

  .links a:hover,
  .links a:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: var(--accent);
  }

  .links a:hover :global(svg) {
    transform: translateY(-1px) scale(1.08);
  }

  .links a[aria-current] {
    background: rgba(255, 255, 255, 0.13);
    color: var(--accent);
  }

  .tip {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    padding: 4px 9px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgba(22, 23, 24, 0.96);
    color: var(--text);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, -4px);
    pointer-events: none;
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .links a:hover .tip,
  .links a:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (hover: none) {
    .tip {
      display: block;
      clip-path: inset(50%);
    }
  }

  @media (max-width: 640px) {
    .nav-wrap {
      top: 12px;
      padding-inline: 12px;
    }

    .nav {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      width: 100%;
      height: auto;
      padding: 10px 12px 6px;
      border-radius: 20px;
    }

    .brand {
      justify-content: center;
      padding: 2px;
      font-size: 14px;
    }

    .rule {
      width: 100%;
      height: 1px;
      margin: 2px 0 0;
      background: rgba(255, 255, 255, 0.5);
    }

    .links {
      justify-content: space-between;
    }

    .links a {
      width: 44px;
      height: 44px;
    }
  }

  @media print {
    .nav-wrap {
      display: none;
    }
  }
</style>
