---
/** A row of number tiles. Used inside case studies. */
interface Props {
  items: { value: string; label: string }[];
  /** "muted" is for numbers that are not good news. */
  tone?: 'accent' | 'muted';
}
const { items, tone = 'accent' } = Astro.props;
---

<ul class:list={['stats', `tone-${tone}`]}>
  {
    items.map((item) => (
      <li>
        <span class="value">{item.value}</span>
        <span class="label">{item.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin-block: 24px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 20px 22px 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  li:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--accent-rgb), 0.4);
  }

  .value {
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .tone-muted .value {
    color: var(--text);
  }

  .label {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
