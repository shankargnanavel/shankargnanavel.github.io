---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { hero, site } from '../data/site';
import { firstImage } from '../lib/images';

// Drop a cut-out portrait at src/assets/profile/portrait.png and the hero switches to the portrait layout.
const portrait = firstImage('profile/portrait.png', 'profile/portrait.webp', 'profile/portrait.jpg');
---

<section id="home" class:list={['hero', { 'has-portrait': !!portrait }]} data-section="home" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <div class="grid"></div>
    <div class="horizon"></div>
  </div>

  <div class="wrap inner">
    <h1 id="hero-title">
      <span class="hi">{hero.greeting}{' '}</span>
      <span class="name">{site.name}</span>
    </h1>
    <p class="roles">
      <span class="sr-only">{hero.roles.join('. ')}.</span>
      <span class="roles-view" aria-hidden="true">
        {
          hero.roles.map((role, i) => (
            <span class:list={['role', { 'is-active': i === 0 }]} data-role>
              {role}
            </span>
          ))
        }
      </span>
    </p>
    <p class="intro">{hero.intro}</p>
    <div class="cta">
      <a class="pill pill--accent" href="#work">See my work <Icon name="arrow-right" size={16} /></a>
      <a class="pill" href="/resume/">Resume</a>
    </div>
  </div>

  {
    portrait && (
      <Image
        class="portrait"
        src={portrait}
        alt={`Portrait of ${site.name}`}
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 720px, 96vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: 150px 22svh;
    overflow: hidden;
    text-align: center;
  }

  /* Backdrop: a faint grid and a rim-lit horizon in the accent colour. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: 50% 100%;
    -webkit-mask-image: radial-gradient(ellipse 75% 62% at 50% 100%, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse 75% 62% at 50% 100%, #000 0%, transparent 72%);
  }

  .horizon {
    position: absolute;
    left: 50%;
    top: 80%;
    width: max(1500px, 190vw);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(ellipse 60% 30% at 50% 0%, #0c1a14 0%, #030605 45%, #000 100%);
    box-shadow:
      0 0 0 1px rgba(var(--accent-rgb), 0.5),
      0 -18px 70px -6px rgba(var(--accent-rgb), 0.42),
      0 -90px 260px 0 rgba(var(--accent-rgb), 0.2),
      inset 0 26px 70px -26px rgba(var(--accent-rgb), 0.55);
    animation: horizon-rise 1.8s var(--ease-out) both;
  }

  @keyframes horizon-rise {
    from {
      opacity: 0;
      transform: translateY(70px);
    }
  }

  .inner > * {
    animation: rise 1s var(--ease-out) both;
  }
  .inner > :nth-child(2) {
    animation-delay: 0.12s;
  }
  .inner > :nth-child(3) {
    animation-delay: 0.24s;
  }
  .inner > :nth-child(4) {
    animation-delay: 0.36s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  h1 {
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .name {
    font-weight: 600;
  }

  .roles {
    margin-top: 8px;
    color: var(--accent);
    font-size: clamp(24px, 4.2vw, 46px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .roles-view {
    display: grid;
    overflow: hidden;
    padding-block: 0.06em;
  }

  .role {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(70%);
  }

  .role.is-active,
  .role.is-leaving {
    transition:
      transform 0.8s var(--ease-out),
      opacity 0.5s var(--ease);
  }

  .role.is-active {
    opacity: 1;
    transform: none;
  }

  .role.is-leaving {
    opacity: 0;
    transform: translateY(-70%);
  }

  .intro {
    max-width: 44ch;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 18px);
    text-wrap: balance;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .cta .pill:hover :global(svg) {
    transform: translateX(3px);
  }

  /* Portrait layout: text at the top, portrait rising from the bottom, as in the reference. */
  .has-portrait {
    align-items: start;
    padding-bottom: 0;
  }

  .has-portrait .intro,
  .has-portrait .cta {
    display: none;
  }

  .portrait {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: -1;
    width: auto;
    height: min(66svh, 760px);
    max-width: none;
    translate: -50% 0;
    animation: rise 1.4s var(--ease-out) 0.2s both;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 190px;
    }

    .hi {
      display: block;
      font-size: 0.8em;
    }
  }
</style>
